      <button class="cart-drawer-close" id="cartDrawerClose" aria-label="Close">&times;</button>
    </div>
    <div class="cart-drawer-items" id="cartDrawerItems"></div>
    <div class="cart-drawer-empty" id="cartDrawerEmpty">Your cart is empty.</div>
    <div class="cart-drawer-footer">
      <div class="cart-drawer-subtotal"><span>Subtotal</span><span id="cartDrawerSubtotal">₱0</span></div>
      <button class="btn btn-outline" id="cartDrawerCheckout" style="width:100%;">Checkout</button>
      <div class="cart-drawer-note">Mockup preview — checkout is not connected.</div>
    </div>
  </div>
</div>

<div class="quick-view-overlay" id="qvOverlay">
  <div class="quick-view-modal" role="dialog" aria-modal="true" aria-label="Product quick view">
    <button class="qv-close" id="qvClose" aria-label="Close">&times;</button>
    <div class="qv-image">
      <span class="badge" id="qvBadge" style="display:none;"></span>
      <img id="qvImage" src="" alt="">
    </div>
    <div class="qv-details">
      <div class="qv-cat" id="qvCat"></div>
      <h3 class="qv-name" id="qvName"></h3>
      <div class="qv-price" id="qvPrice"></div>
      <p class="qv-desc" id="qvDesc"></p>
      <div class="qv-label">Color</div>
      <div class="qv-swatches" id="qvSwatches"></div>
      <div class="qv-label">Size</div>
      <div class="qv-sizes" id="qvSizes"></div>
      <div class="qv-label">Quantity</div>
      <div class="qv-qty">
        <button id="qvMinus" type="button" aria-label="Decrease quantity">&minus;</button>
        <span id="qvQtyVal">1</span>
        <button id="qvPlus" type="button" aria-label="Increase quantity">+</button>
      </div>
      <div class="qv-actions">
        <button class="btn btn-outline" id="qvAddToCart" type="button">Add to Cart</button>
      </div>
      <div class="qv-note">Mockup preview — checkout is not connected.</div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
<script src="data/constants.js"></script>
<script src="data/supabase-client.js"></script>
<script src="data/render.js"></script>
<script src="data/cart.js"></script>
<script>
  // sticky header shrink
  const header = document.getElementById('siteHeader');
  window.addEventListener('scroll', () => {
    header.classList.toggle('scrolled', window.scrollY > 60);
  });

  // mobile menu
  const hamburgerBtn = document.getElementById('hamburgerBtn');
  const closeMenuBtn = document.getElementById('closeMenuBtn');
  const mobileMenu = document.getElementById('mobileMenu');
  hamburgerBtn.addEventListener('click', () => mobileMenu.classList.add('open'));
  closeMenuBtn.addEventListener('click', () => mobileMenu.classList.remove('open'));
  mobileMenu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => mobileMenu.classList.remove('open')));

  // scroll reveal
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('in');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  // simple countdown timer for limited drop
  let remaining = (3*24*3600) + (14*3600) + (22*60) + 5;
  const countdownEls = document.querySelectorAll('.countdown');
  function tick(){
    remaining = Math.max(0, remaining - 1);
    const d = Math.floor(remaining/86400);
    const h = Math.floor((remaining%86400)/3600);
    const m = Math.floor((remaining%3600)/60);
    const s = remaining%60;
    countdownEls.forEach(c => {
      const nums = c.querySelectorAll('.num');
      nums[0].textContent = String(d).padStart(2,'0');
      nums[1].textContent = String(h).padStart(2,'0');
      nums[2].textContent = String(m).padStart(2,'0');
      nums[3].textContent = String(s).padStart(2,'0');
    });
  }
  setInterval(tick, 1000);

  document.querySelectorAll('.cat-card').forEach(card => {
    card.addEventListener('click', () => {
      const nameEl = card.querySelector('.cat-name');
      if (!nameEl) return;
      const slug = nameEl.textContent.trim().toLowerCase();
      window.location.href = withCart('shop.html?category=' + encodeURIComponent(slug));
    });
  });

  // ===== Quick View modal =====
  const qvOverlay = document.getElementById('qvOverlay');
  const qvImage = document.getElementById('qvImage');
  const qvBadge = document.getElementById('qvBadge');
  const qvCat = document.getElementById('qvCat');
  const qvName = document.getElementById('qvName');
  const qvPrice = document.getElementById('qvPrice');
  const qvDesc = document.getElementById('qvDesc');
  const qvSwatches = document.getElementById('qvSwatches');
  const qvSizes = document.getElementById('qvSizes');
  const qvQtyVal = document.getElementById('qvQtyVal');
  const qvClose = document.getElementById('qvClose');
  let qvProductId = null;
  let qvCartImg = '';
  let qvSelectedColor = '';

  function openQuickView(card){
    const img = card.querySelector('.ph img');
    const badge = card.querySelector('.badge');
    const cat = card.querySelector('.p-cat').textContent;
    const name = card.querySelector('.p-name').textContent;
    const price = card.querySelector('.p-price').textContent;
    const swatchColors = [...card.querySelectorAll('.swatch')].map(s => s.style.background);
    const sizes = (card.dataset.sizes || 'One Size').split(',');

    qvProductId = card.dataset.id;
    qvCartImg = card.dataset.img || img.src;
    qvSelectedColor = swatchColors[0] || '';
    qvImage.src = img.src;
    qvImage.alt = img.alt || name;
    if (badge){ qvBadge.textContent = badge.textContent; qvBadge.style.display = ''; }
    else { qvBadge.style.display = 'none'; }
    qvCat.textContent = cat;
    qvName.textContent = name;
    qvPrice.textContent = price;
    qvDesc.textContent = card.dataset.desc || '';

    qvSwatches.innerHTML = '';
    swatchColors.forEach((c, i) => {
      const s = document.createElement('span');
      s.className = 'swatch' + (i === 0 ? ' selected' : '');
      s.style.background = c;
      s.addEventListener('click', () => {
        qvSwatches.querySelectorAll('.swatch').forEach(el => el.classList.remove('selected'));
        s.classList.add('selected');
        qvSelectedColor = c;
      });
      qvSwatches.appendChild(s);
    });

    qvSizes.innerHTML = '';
    sizes.forEach((sz, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'qv-size' + (i === 0 ? ' selected' : '');
      b.textContent = sz.trim();
      b.addEventListener('click', () => {
        qvSizes.querySelectorAll('.qv-size').forEach(el => el.classList.remove('selected'));
        b.classList.add('selected');
      });
      qvSizes.appendChild(b);
    });

    qvQtyVal.textContent = '1';
    qvOverlay.classList.add('open');
    document.body.classList.add('modal-open');
  }

  function closeQuickView(){
    qvOverlay.classList.remove('open');
    document.body.classList.remove('modal-open');
  }

  qvClose.addEventListener('click', closeQuickView);
  qvOverlay.addEventListener('click', (e) => { if (e.target === qvOverlay) closeQuickView(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeQuickView(); });

  document.getElementById('qvMinus').addEventListener('click', () => {
    qvQtyVal.textContent = String(Math.max(1, Number(qvQtyVal.textContent) - 1));
  });
  document.getElementById('qvPlus').addEventListener('click', () => {
    qvQtyVal.textContent = String(Number(qvQtyVal.textContent) + 1);
  });
  document.getElementById('qvAddToCart').addEventListener('click', () => {
    const size = qvSizes.querySelector('.qv-size.selected');
    addToCart({
      id: qvProductId,
      name: qvName.textContent,
      price: parsePrice(qvPrice.textContent),
      img: qvCartImg || qvImage.src,
      qty: Number(qvQtyVal.textContent),
      size: size ? size.textContent : '',
      color: qvSelectedColor
    });
    closeQuickView();
  });

  document.querySelectorAll('.product-grid').forEach(grid => {
    grid.addEventListener('click', (e) => {
      const quickAdd = e.target.closest('.quick-add');
      if (quickAdd){
        const card = quickAdd.closest('.product-card');
        if (!card) return;
        const img = card.querySelector('.ph img');
        const name = card.querySelector('.p-name').textContent;
        const price = parsePrice(card.querySelector('.p-price').textContent);
        const firstSwatch = card.querySelector('.swatch');
        const size = (card.dataset.sizes || '').split(',')[0].trim();
        addToCart({ id: card.dataset.id, name, price, img: card.dataset.img || img.src, qty: 1, size, color: firstSwatch ? firstSwatch.style.background : '' });
        quickAdd.textContent = 'Added ✓';
        quickAdd.classList.add('added');
        setTimeout(() => { quickAdd.textContent = 'Quick Add'; quickAdd.classList.remove('added'); }, 1100);
        return;
      }
      if (e.target.closest('.swatch')) return;
      const card = e.target.closest('.product-card');
      if (card) openQuickView(card);
    });
  });

  // ===== Load catalog + gallery from Supabase =====
  async function initStorefront(){
    try {
      const products = await CarpeDB.fetchProducts();
      mountGrid(document.getElementById('bestSellersGrid'), products.filter(p => p.best_seller), renderProductCard);
      mountGrid(document.getElementById('newArrivalsGrid'), products.filter(p => p.new_arrival), renderProductCard);
      mountGrid(document.getElementById('trendingFitsGrid'), products.filter(p => p.trending), renderProductCard);
      mountGrid(document.getElementById('collectionsGrid'), products.filter(p => p.collection), renderProductCard);
    } catch (err) {
      console.error('Failed to load products from Supabase', err);
    }
    try {
      const gallery = await CarpeDB.fetchGallery();
      mountGrid(document.getElementById('customerGalleryGrid'), gallery, renderGalleryTile);
    } catch (err) {
      console.error('Failed to load gallery from Supabase', err);
    }
  }
  initStorefront();
</script>
</body>
</html>
